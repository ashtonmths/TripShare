# @public @required=false @type=string
GOOGLE_CLIENT_ID=

# @required=false @type=string
GOOGLE_CLIENT_SECRET=

# Comma-separated Google account emails allowed to access server-enforced admin tools.
# @required=false @type=string
ADMIN_EMAILS=
