{
	"expo": {
		"name": "TripShare",
		"slug": "tripshare",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "TripShare",
		"userInterfaceStyle": "automatic",
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "app.tripshare.mobile"
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#E2EEE8",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"backgroundImage": "./assets/images/android-icon-background.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false,
			"package": "app.tripshare.mobile"
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#f6f4ed",
					"dark": {
						"backgroundColor": "#111714"
					}
				}
			]
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "6586b9fa-c73e-4d68-8a5a-8b06c5cac53f"
			}
		},
		"owner": "ashtonmths.dev",
		"runtimeVersion": {
			"policy": "appVersion"
		},
		"updates": {
			"url": "https://u.expo.dev/6586b9fa-c73e-4d68-8a5a-8b06c5cac53f"
		}
	}
}
