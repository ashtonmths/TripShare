{
	"name": "TripShare",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:native": "turbo run dev -F native --",
		"dev:web": "turbo run dev -F web --",
		"db:push": "pnpm --filter @TripShare/db db:push",
		"db:studio": "pnpm --filter @TripShare/db db:studio",
		"db:generate": "pnpm --filter @TripShare/db db:generate",
		"db:migrate": "pnpm --filter @TripShare/db db:migrate",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
		"check": "biome check --write ."
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@TripShare/config": "workspace:*",
		"@biomejs/biome": "^2.5.12",
		"@types/node": "catalog:",
		"turbo": "^2.10.12",
		"typescript": "^6.0.3",
		"varlock": "catalog:"
	},
	"packageManager": "pnpm@11.9.0"
}
